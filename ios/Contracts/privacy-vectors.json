{
  "description": "Shared by src/shared/ios-privacy-contract.test.ts (the Mac's privacy.ts) and by ios/LuciumKit (TrackingParams, HttpsUpgrade, PrivacyRules). One file, two implementations: when a rule changes on one side, the other side's tests fail until the vectors say the same on both. The addresses are in the form WebKit hands to the application (lower-case host, a path), which is also the form of the Mac's URL; the Swift side keeps the rest of an address exactly as it is given.",
  "trackingParams": [
    { "url": "https://example.com/page?utm_source=news&utm_medium=mail&id=7", "expect": "https://example.com/page?id=7" },
    { "url": "https://example.com/page?id=7", "expect": null },
    { "url": "https://example.com/page", "expect": null },
    { "url": "https://example.com/page?", "expect": null },
    { "url": "https://example.com/page?fbclid=abc", "expect": "https://example.com/page" },
    { "url": "https://example.com/page?fbclid=abc#top", "expect": "https://example.com/page#top" },
    { "url": "https://example.com/page?a=1&gclid=x&b=2", "expect": "https://example.com/page?a=1&b=2" },
    { "url": "https://example.com/page?UTM_Source=x", "expect": "https://example.com/page" },
    { "url": "https://example.com/page?%75tm_source=x", "expect": "https://example.com/page" },
    { "url": "https://example.com/page?pk_live=1&pk_campaign=x", "expect": "https://example.com/page?pk_live=1" },
    { "url": "https://example.com/page?utm_source", "expect": "https://example.com/page" },
    { "url": "https://example.com/page?q=a+b&utm_term=x", "expect": "https://example.com/page?q=a+b" },
    { "url": "https://example.com/?ref=home&utm_campaign=c", "expect": "https://example.com/?ref=home" },
    { "url": "https://example.com/page?mc_eid=1&mc_cid=2", "expect": "https://example.com/page" },
    { "url": "https://example.com/page?_gl=1*abc", "expect": "https://example.com/page" },
    { "url": "http://example.com/p?igshid=1", "expect": "http://example.com/p" },
    { "url": "https://example.com/page?q=%FF&utm_source=x", "expect": "https://example.com/page?q=%FF" },
    { "url": "https://example.com/page?utm_source=x&utm_medium=y", "expect": "https://example.com/page" },
    { "url": "https://example.com/page?a=b=c&utm_x=1", "expect": "https://example.com/page?a=b=c" },
    { "url": "https://example.com/page?msclkid=1&keep", "expect": "https://example.com/page?keep" },
    { "url": "https://example.com/page?ref=utm_source", "expect": null },
    { "url": "https://example.com/page?autm_source=1", "expect": null },
    { "url": "ftp://example.com/?utm_source=x", "expect": null },
    { "url": "about:blank", "expect": null },
    { "url": "not a url", "expect": null }
  ],
  "isUpgradableHost": [
    { "host": "example.com", "expect": true },
    { "host": "EXAMPLE.COM", "expect": true },
    { "host": "example.com.", "expect": true },
    { "host": "www.example.co.uk", "expect": true },
    { "host": "localhost", "expect": false },
    { "host": "app.localhost", "expect": false },
    { "host": "router.local", "expect": false },
    { "host": "nas.lan", "expect": false },
    { "host": "a.home.arpa", "expect": false },
    { "host": "x.corp", "expect": false },
    { "host": "intranet", "expect": false },
    { "host": "", "expect": false },
    { "host": "8.8.8.8", "expect": true },
    { "host": "0.0.0.0", "expect": false },
    { "host": "10.0.0.1", "expect": false },
    { "host": "127.0.0.1", "expect": false },
    { "host": "192.168.1.1", "expect": false },
    { "host": "172.16.0.1", "expect": false },
    { "host": "172.31.255.1", "expect": false },
    { "host": "172.15.0.1", "expect": true },
    { "host": "172.32.0.1", "expect": true },
    { "host": "169.254.1.1", "expect": false },
    { "host": "100.64.0.1", "expect": false },
    { "host": "100.127.0.1", "expect": false },
    { "host": "100.128.0.1", "expect": true },
    { "host": "[::1]", "expect": false },
    { "host": "[::]", "expect": false },
    { "host": "[fe80::1]", "expect": false },
    { "host": "[fd00::1]", "expect": false },
    { "host": "[::ffff:10.0.0.1]", "expect": false },
    { "host": "[2001:db8::1]", "expect": true }
  ],
  "httpsUpgrade": [
    { "url": "http://example.com/a?b=1", "expect": "https://example.com/a?b=1" },
    { "url": "http://example.com/", "expect": "https://example.com/" },
    { "url": "http://example.com:80/x", "expect": "https://example.com/x" },
    { "url": "http://example.com:8080/x", "expect": null },
    { "url": "http://example.com:443/x", "expect": null },
    { "url": "https://example.com/", "expect": null },
    { "url": "ftp://example.com/", "expect": null },
    { "url": "http://localhost/", "expect": null },
    { "url": "http://localhost:3000/", "expect": null },
    { "url": "http://192.168.1.10/x", "expect": null },
    { "url": "http://8.8.8.8/x", "expect": "https://8.8.8.8/x" },
    { "url": "http://[::1]/", "expect": null },
    { "url": "http://printer.local/", "expect": null },
    { "url": "http://intranet/", "expect": null },
    { "url": "http://user:secret@example.com/", "expect": null },
    { "url": "http://user@example.com/", "expect": null },
    { "url": "http://example.com/a#frag", "expect": "https://example.com/a#frag" },
    { "url": "HTTP://example.com/a", "expect": "https://example.com/a" },
    { "url": "not a url", "expect": null }
  ],
  "rewrite": [
    { "url": "http://example.com/a?utm_source=x", "options": { "httpsUpgrade": true, "globalPrivacyControl": true, "stripTrackingParams": true }, "expect": "https://example.com/a" },
    { "url": "http://example.com/a?utm_source=x", "options": { "httpsUpgrade": false, "globalPrivacyControl": false, "stripTrackingParams": true }, "expect": "http://example.com/a" },
    { "url": "http://example.com/a?utm_source=x", "options": { "httpsUpgrade": true, "globalPrivacyControl": false, "stripTrackingParams": false }, "expect": "https://example.com/a?utm_source=x" },
    { "url": "https://example.com/a?utm_source=x", "options": { "httpsUpgrade": true, "globalPrivacyControl": true, "stripTrackingParams": true }, "expect": "https://example.com/a" },
    { "url": "https://example.com/a?id=1", "options": { "httpsUpgrade": true, "globalPrivacyControl": true, "stripTrackingParams": true }, "expect": null },
    { "url": "http://localhost:3000/a?utm_source=x", "options": { "httpsUpgrade": true, "globalPrivacyControl": true, "stripTrackingParams": true }, "expect": "http://localhost:3000/a" },
    { "url": "http://example.com/a?utm_source=x", "options": { "httpsUpgrade": false, "globalPrivacyControl": false, "stripTrackingParams": false }, "expect": null },
    { "url": "http://example.com/a", "method": "POST", "options": { "httpsUpgrade": true, "globalPrivacyControl": true, "stripTrackingParams": true }, "expect": null },
    { "url": "http://example.com/a", "isMainFrame": false, "options": { "httpsUpgrade": true, "globalPrivacyControl": true, "stripTrackingParams": true }, "expect": null }
  ]
}
