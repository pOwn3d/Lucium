{
  "description": "Shared by src/shared/ios-file-names-contract.test.ts (the Mac's suggestedFileName, uniquePath and pdfFileName) and by ios/LuciumKit (FileNames, UniqueFileName, PageShare). One file, two implementations: when a rule changes on one side, the other side's tests fail until the vectors say the same on both. A text may be written as {\"repeat\": \"é\", \"times\": 300, \"suffix\": \".pdf\"} so that a long name does not fill the file; \"prefix\" works the same way.",
  "suggested": [
    { "input": "Rapport 2026.pdf", "expect": "Rapport 2026.pdf" },
    { "input": "../../etc/passwd", "expect": "passwd" },
    { "input": "C:\\Windows\\evil.txt", "expect": "evil.txt" },
    { "input": "/abs/olute/name.bin", "expect": "name.bin" },
    { "input": "", "expect": "téléchargement" },
    { "input": ".", "expect": "téléchargement" },
    { "input": "..", "expect": "téléchargement" },
    { "input": "...", "expect": "téléchargement" },
    { "input": "   ", "expect": "téléchargement" },
    { "input": "/", "expect": "téléchargement" },
    { "input": "\u0000", "expect": "téléchargement" },
    { "input": "fi\u202Efdp.exe", "expect": "fifdp.exe" },
    { "input": "a\u0000b\nc.txt", "expect": "abc.txt" },
    { "input": "a\u007fb\u0085c.txt", "expect": "abc.txt" },
    { "input": "a\u2028b\u2029c.txt", "expect": "abc.txt" },
    { "input": "\u2066x\u2069.txt", "expect": "x.txt" },
    { "input": ".bashrc", "expect": "bashrc" },
    { "input": "name. ", "expect": "name" },
    { "input": "  two   spaces and a line.txt  ", "expect": "two spaces and a line.txt" },
    { "input": "a\tb.txt", "expect": "ab.txt" },
    { "input": "a\u00a0b\u3000c\ufeffd.txt", "expect": "a b c d.txt" },
    { "input": "a:b?c*d.txt", "expect": "a:b?c*d.txt" },
    { "input": "CON.txt", "expect": "CON.txt" },
    { "input": "archive.tar.gz", "expect": "archive.tar.gz" },
    { "input": "no-extension", "expect": "no-extension" },
    { "input": "😀 smile.png", "expect": "😀 smile.png" },
    { "input": { "repeat": "é", "times": 300, "suffix": ".pdf" }, "expect": { "repeat": "é", "times": 118, "suffix": ".pdf" } },
    { "input": { "repeat": "a", "times": 300, "suffix": "." }, "expect": { "repeat": "a", "times": 240 } },
    { "input": { "repeat": "a", "times": 300, "suffix": { "repeat": "b", "times": 301, "prefix": "." } }, "expect": { "repeat": "a", "times": 240 } },
    { "input": { "repeat": "a", "times": 10000, "suffix": "/tail.pdf" }, "expect": { "repeat": "a", "times": 240 } },
    { "input": { "repeat": "😀", "times": 200, "suffix": ".png" }, "expect": { "repeat": "😀", "times": 59, "suffix": ".png" } }
  ],
  "unique": [
    { "name": "report.pdf", "taken": [], "expect": "report.pdf" },
    { "name": "report.pdf", "taken": ["report.pdf"], "expect": "report (1).pdf" },
    { "name": "report.pdf", "taken": ["report.pdf", "report (1).pdf"], "expect": "report (2).pdf" },
    { "name": "report.pdf", "taken": ["Report.PDF"], "expect": "report (1).pdf" },
    { "name": "backup.tar.gz", "taken": ["backup.tar.gz"], "expect": "backup (1).tar.gz" },
    { "name": "backup.TAR.bz2", "taken": ["backup.TAR.bz2"], "expect": "backup (1).TAR.bz2" },
    { "name": "archive.tar", "taken": ["archive.tar"], "expect": "archive (1).tar" },
    { "name": "no-extension", "taken": ["no-extension"], "expect": "no-extension (1)" },
    { "name": "bashrc", "taken": ["bashrc", "bashrc (1)"], "expect": "bashrc (2)" },
    { "name": "photo.final.jpg", "taken": ["photo.final.jpg"], "expect": "photo.final (1).jpg" }
  ],
  "pdfName": [
    { "title": "Rapport 2026", "expect": "Rapport 2026.pdf" },
    { "title": "AC/DC: Back in Black", "expect": "AC-DC- Back in Black.pdf" },
    { "title": "already.pdf", "expect": "already.pdf" },
    { "title": "Already.PDF", "expect": "Already.PDF" },
    { "title": "", "expect": "page.pdf" },
    { "title": "   ", "expect": "page.pdf" },
    { "title": "../../etc/passwd", "expect": "-..-etc-passwd.pdf" },
    { "title": { "repeat": "é", "times": 300 }, "expect": { "repeat": "é", "times": 120, "suffix": ".pdf" } }
  ]
}
