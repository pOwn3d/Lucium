    "lock.settings.app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock Lucium"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller Lucium"
          }
        }
      }
    },
    "lock.settings.app.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucium locks when you leave it, and asks for Face ID, Touch ID or your passcode when you come back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucium se verrouille quand vous le quittez et demande Face ID, Touch ID ou votre code à votre retour."
          }
        }
      }
    },
    "lock.settings.limits": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock covers the screens of Lucium. It does not encrypt the files of the application."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrou couvre les écrans de Lucium. Il ne chiffre pas les fichiers de l'application."
          }
        }
      }
    },
    "lock.settings.spaces.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A locked space keeps its tabs asleep and hidden until you unlock it. It locks again each time you leave Lucium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace verrouillé garde ses onglets endormis et masqués jusqu'à son déverrouillage. Il se reverrouille chaque fois que vous quittez Lucium."
          }
        }
      }
    },
    "lock.settings.spaces.header": {
      "localizations": {
