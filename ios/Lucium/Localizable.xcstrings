      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone will no longer connect to it. For the Mac to forget this iPhone too, forget it in Lucium’s settings on the Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone ne s’y connectera plus. Pour que le Mac l’oublie aussi, oubliez cet iPhone dans les réglages de Lucium sur le Mac."
          }
        }
      }
    },
