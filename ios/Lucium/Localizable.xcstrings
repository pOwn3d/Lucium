        }
      }
    },
    "sync.pairing.type.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address and the code are written under the QR code, on the Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse et le code sont écrits sous le code QR, sur le Mac."
          }
