    "licenses.app.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucium is free software under the GNU GPL, version 3 or later, with an additional permission that lets it be handed out through the App Store and TestFlight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucium est un logiciel libre sous GNU GPL, version 3 ou ultérieure, avec une permission additionnelle qui permet de le distribuer par l’App Store et TestFlight."
          }
        }
      }
    },
