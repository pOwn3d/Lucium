    "sync.error.bad-proof": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac did not prove it knows the code. Show a new code on the Mac and start again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac n’a pas prouvé qu’il connaît le code. Affichez un nouveau code sur le Mac et recommencez."
          }
        }
      }
    },
    "sync.error.busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another synchronization is running with this Mac. Try again in a moment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre synchronisation est en cours avec ce Mac. Réessayez dans un instant."
          }
        }
      }
    },
    "sync.error.divergence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two devices do not agree: nothing was changed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux appareils ne s’accordent pas : rien n’a été changé."
          }
        }
      }
    },
    "sync.error.fingerprint-mismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not the Mac of the code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas le Mac du code."
          }
        }
      }
    },
    "sync.error.identity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone could not create the synchronization key (the keychain refused). Unlock the device and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone n’a pas pu créer la clé de la synchronisation (le trousseau a refusé). Déverrouillez l’appareil et réessayez."
          }
        }
      }
    },
    "sync.error.internal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A problem occurred on this iPhone. Try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu sur cet iPhone. Réessayez."
          }
        }
      }
    },
    "sync.error.invalid-code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a Lucium pairing code. Read the code shown on the Mac again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un code d’appairage de Lucium. Lisez de nouveau le code affiché sur le Mac."
          }
        }
      }
    },
    "sync.error.locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucium is locked on the Mac. Unlock it: synchronization resumes by itself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucium est verrouillé sur le Mac. Déverrouillez-le : la synchronisation reprend toute seule."
          }
        }
      }
    },
    "sync.error.not-paired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac no longer knows this iPhone. Pair them again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne connaît plus cet iPhone. Appairez-les de nouveau."
          }
        }
      }
    },
    "sync.error.pairing-closed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing was closed on the Mac. Open it again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appairage a été fermé sur le Mac. Ouvrez-le de nouveau."
          }
        }
      }
    },
    "sync.error.pairing-expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code has expired. Show a new one on the Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code a expiré. Affichez-en un nouveau sur le Mac."
          }
        }
      }
    },
    "sync.error.pairing-locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many tries with this code. Show a new one on the Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop d’essais avec ce code. Affichez-en un nouveau sur le Mac."
          }
        }
      }
    },
    "sync.error.pairing-refused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac refused the pairing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac a refusé l’appairage."
          }
        }
      }
    },
    "sync.error.pairing-used": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code has already been used. Show a new one on the Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code a déjà été utilisé. Affichez-en un nouveau sur le Mac."
          }
        }
      }
    },
    "sync.error.protocol": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac and the iPhone did not understand each other. Try again; if it keeps happening, update Lucium on both."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac et l’iPhone ne se sont pas compris. Réessayez ; si cela continue, mettez Lucium à jour des deux côtés."
          }
        }
      }
    },
    "sync.error.rate-limited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac received too many connections. Try again in a minute."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac a reçu trop de connexions. Réessayez dans une minute."
          }
        }
      }
    },
    "sync.error.state-too-new": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other Lucium is newer: update this one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autre Lucium est plus récent : mettez celui-ci à jour."
          }
        }
      }
    },
    "sync.error.timeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac did not answer in time. Try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac n’a pas répondu à temps. Réessayez."
          }
        }
      }
    },
    "sync.error.truncated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exchange stopped before the end. Nothing was changed; try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’échange s’est arrêté avant la fin. Rien n’a été changé ; réessayez."
          }
        }
      }
    },
    "sync.error.unsupported-version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two Luciums do not speak the same version: update them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux Lucium ne parlent pas la même version : mettez-les à jour."
          }
        }
      }
    },
    "sync.interval.five-minutes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every 5 minutes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 5 minutes"
          }
        }
      }
    },
    "sync.interval.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucium synchronizes by itself, in both directions, while it is open on the screen. In the background iOS suspends it, so nothing is exchanged until you come back. If the Mac does not answer, Lucium waits longer between attempts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucium se synchronise tout seul, dans les deux sens, tant qu’il est ouvert à l’écran. En arrière-plan, iOS le suspend : rien n’est échangé avant votre retour. Si le Mac ne répond pas, Lucium espace ses essais."
          }
        }
      }
    },
    "sync.interval.half-minute": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every 30 seconds"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 30 secondes"
          }
        }
      }
    },
    "sync.interval.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic synchronization"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation automatique"
          }
        }
      }
    },
    "sync.interval.minute": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every minute"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque minute"
          }
        }
      }
    },
    "sync.interval.picker": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pace"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rythme"
          }
        }
      }
    },
    "sync.interval.quarter-hour": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every 15 minutes"
