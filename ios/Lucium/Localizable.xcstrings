        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a passcode in the iOS Settings to use the lock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un code dans les Réglages d'iOS pour utiliser le verrou."
          }
        }
