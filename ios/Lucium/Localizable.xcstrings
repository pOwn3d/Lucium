    "sync.pairing.unreachable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac not found at these addresses. It must be on, on the same network, with the pairing window open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac introuvable à ces adresses. Il doit être allumé, sur le même réseau, avec la fenêtre d’appairage ouverte."
          }
        }
      }
    },
    "sync.pairing.waiting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the Mac, tap “Allow”. A code then appears here, to compare with the one on the Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le Mac, touchez « Autoriser ». Un code s’affiche alors ici, à comparer avec celui du Mac."
          }
        }
      }
    },
    "sync.state.clock-skew": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clocks of the two devices differ by more than 5 minutes: in a conflict, the choice of the most recent may be wrong."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les horloges des deux appareils diffèrent de plus de 5 minutes : en cas de conflit, le choix du plus récent peut se tromper."
          }
        }
      }
    },
    "sync.state.identity-lost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy of Lucium no longer has the synchronization key (restore, reinstall). Pair the Mac again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie de Lucium n’a plus la clé de la synchronisation (restauration, réinstallation). Appairez le Mac de nouveau."
          }
        }
      }
    },
    "sync.state.idle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready. No exchange yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prête. Aucun échange pour l’instant."
          }
        }
      }
    },
    "sync.state.interrupted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exchange interrupted. Nothing was changed; it will start again at the next synchronization."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échange interrompu. Rien n’a été changé ; il reprendra à la prochaine synchronisation."
          }
        }
      }
    },
    "sync.state.local-network-denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucium is not allowed to use the local network: iOS Settings › Lucium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucium n’a pas le droit d’utiliser le réseau local : Réglages d’iOS › Lucium."
          }
        }
      }
    },
    "sync.state.mac-answered %@": {
