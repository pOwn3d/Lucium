    "sync.pairing.waiting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the Mac, tap “Allow”. It waits 60 seconds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le Mac, touchez « Autoriser ». Il attend 60 secondes."
          }
        }
      }
