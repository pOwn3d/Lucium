      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Today tab you have not opened for this long goes to the archive, in the profile “%@”. Pinned tabs and favorites are never archived. The change applies the next time Lucium comes to the front."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet d’« Aujourd’hui » que vous n’avez pas ouvert pendant ce délai part dans l’archive, dans le profil « %@ ». Les onglets épinglés et les favoris ne sont jamais archivés. Le changement s’applique à la prochaine ouverture de Lucium."
          }
        }
      }
    },
