          "stringUnit": {
            "state": "translated",
            "value": "Lock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillage"
          }
        }
      }
    },
    "lock.sheet.locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This space is locked. Its tabs are hidden until you unlock it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet espace est verrouillé. Ses onglets sont masqués tant que vous ne l'avez pas déverrouillé."
          }
        }
      }
    },
    "lock.sheet.short": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillé"
          }
        }
