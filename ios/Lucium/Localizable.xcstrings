    "settings.tabs.awake.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many tabs keep their page loaded at once. The others go to sleep: they stay in the list and reload when you open them. The tab on screen and a tab that is playing sound or video, or using the camera or microphone, never sleep. Fewer tabs spare memory and battery. This setting belongs to this device and is not synchronized."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre d’onglets dont la page reste chargée en même temps. Les autres se mettent en veille : ils restent dans la liste et se rechargent à l’ouverture. L’onglet à l’écran et un onglet qui joue un son ou une vidéo, ou qui utilise la caméra ou le micro, ne dorment jamais. Moins d’onglets, c’est moins de mémoire et de batterie. Ce réglage est propre à cet appareil et n’est pas synchronisé."
          }
        }
      }
    },
    "settings.tabs.awake.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs kept in memory"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onglets gardés en mémoire"
          }
        }
      }
    },
