    "licenses.lists.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These lists are built into the application and are never downloaded: they are updated with the application only. Each list keeps its own license."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces listes sont intégrées à l’application et ne sont jamais téléchargées : elles ne sont mises à jour qu’avec l’application. Chaque liste garde sa licence."
          }
        }
      }
    },
    "licenses.lists.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter lists"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listes de filtres"
          }
        }
      }
    },
    "licenses.lists.none": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No filter list is built into this copy of the application."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune liste de filtres n’est intégrée à cette copie de l’application."
          }
        }
      }
    },
    "licenses.lists.unreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The credits of the filter lists cannot be read in this copy of the application."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les crédits des listes de filtres sont illisibles dans cette copie de l’application."
          }
        }
      }
    },
