    "archive.clear": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the archive"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider l’archive"
          }
        }
      }
    },
    "archive.clear.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archived tabs are forgotten for good. Open tabs are not touched."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets archivés sont oubliés pour de bon. Les onglets ouverts ne sont pas touchés."
          }
        }
      }
    },
