    },
    "lock.notice.save-failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock setting could not be saved, so it was not changed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réglage du verrou n'a pas pu être enregistré ; il n'a donc pas été modifié."
