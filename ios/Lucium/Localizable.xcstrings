    "privacy.strip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove tracking parameters from addresses"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer les paramètres de suivi des adresses"
          }
        }
      }
    },
    "privacy.strip-help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes a fixed list of parameters (utm_*, fbclid, gclid…) from the addresses you open. A parameter that picks the page, the language or the item shown is never removed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire une liste fixe de paramètres (utm_*, fbclid, gclid…) des adresses que vous ouvrez. Un paramètre qui choisit la page, la langue ou l’élément affiché n’est jamais retiré."
          }
        }
      }
    },
