      }
    },
    "lock.notice.unreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock settings could not be read. To be safe, Lucium is locked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages du verrou n'ont pas pu être lus. Par précaution, Lucium est verrouillé."
          }
