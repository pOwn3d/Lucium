    "archive.clear": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the archive"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider l’archive"
