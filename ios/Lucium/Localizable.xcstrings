    "sync.limits": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be on, on the same network, with Lucium open on both. Synchronization runs by itself while Lucium is open on the iPhone; iOS pauses it in the background. Passwords, cookies, sessions, automatic sign-ins to websites, locks and history are never sent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux appareils doivent être allumés, sur le même réseau, Lucium ouvert sur les deux. La synchronisation se fait toute seule tant que Lucium est ouvert sur l’iPhone ; iOS la met en pause en arrière-plan. Les mots de passe, les cookies, les sessions, les connexions automatiques aux sites, les verrous et l’historique ne sont jamais envoyés."
          }
        }
      }
    },
    "sync.mac.add": {
      "localizations": {
