    "settings.appearance.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“System” follows the iPhone. With it, a space whose theme is light or dark keeps its own look while you browse in it. This choice stays on this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Système » suit l’iPhone. Avec lui, un espace dont le thème est clair ou sombre garde son propre aspect quand vous y naviguez. Ce choix reste sur cet appareil."
          }
        }
      }
