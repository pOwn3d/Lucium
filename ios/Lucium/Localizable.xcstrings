    "settings.history.record.footer %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pages you visit in the profile “%@” are noted on this iPhone so you can find them again from the command bar. Nothing is noted in a private tab, and the history is never synchronized with the Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages que vous visitez dans le profil « %@ » sont notées sur cet iPhone, pour les retrouver depuis la barre de commandes. Rien n’est noté dans un onglet privé, et l’historique n’est jamais synchronisé avec le Mac."
          }
        }
      }
    },
