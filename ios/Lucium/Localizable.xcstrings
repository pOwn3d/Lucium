    "settings.reset.confirm.message %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The search engine of the profile “%@”, the privacy settings and whether the history is kept go back to their original values. The pages already kept, the lock, the spaces and the synchronization do not change."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de recherche du profil « %@ », la vie privée et le choix de garder l’historique reviennent à leur valeur d’origine. Les pages déjà gardées, le verrouillage, les espaces et la synchronisation ne changent pas."
          }
        }
      }
    },
