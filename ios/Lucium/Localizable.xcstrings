    },
    "lock.notice.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device cannot check who you are right now. Try again in a moment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas vérifier votre identité pour le moment. Réessayez dans un instant."
