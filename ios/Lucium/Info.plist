<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The keys Xcode generates (project.yml, INFOPLIST_KEY_*) are merged into this file. Only what a build setting cannot hold is written here. -->
	<!-- A browser opens the pages the person asks for, and some of them are http: with HTTPS first, an http page is what a site that does not answer
	     over HTTPS falls back to, and without this key WebKit refuses it on the device (App Transport Security). The key lifts the rule for web
	     content only: nothing else in the application is allowed a plain connection, and it makes none of its own (docs/ios.md, "Vie privée"). -->
	<!-- The folder of the downloads (Documents/Downloads) shows in the Files app, under "On My iPhone > Lucium": that is where a file goes (docs/ios.md,
	     "Téléchargements"). Nothing else is kept in Documents. -->
	<!-- Export compliance: no ITSAppUsesNonExemptEncryption key, on purpose (docs/synchronisation.md, section 15). The key said false while the only encryption in the
	     application was what iOS provides for HTTPS. The synchronisation with the Mac also opens an encrypted connection to another device (TLS 1.3 of
	     Network.framework) and authenticates its messages (an HMAC), and Apple's documentation does not say that such an application stays exempt; the question is
	     about the build, not about the switch, so the code is in every build. Without the key App Store Connect asks for each upload, the maintainer answers, and the
	     key comes back with the value the answer gives, after the security review (card 448). No build is sent before that. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>
