<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The keys Xcode generates (project.yml, INFOPLIST_KEY_*) are merged into this file. Only what a build setting cannot hold is written here. -->
	<!-- A browser opens the pages the person asks for, and some of them are http: with HTTPS first, an http page is what a site that does not answer
	     over HTTPS falls back to, and without this key WebKit refuses it on the device (App Transport Security). The key lifts the rule for web
	     content only: nothing else in the application is allowed a plain connection, and it makes none of its own (docs/ios.md, "Vie privée"). -->
	<!-- The folder of the downloads (Documents/Downloads) shows in the Files app, under "On My iPhone > Lucium": that is where a file goes (docs/ios.md,
	     "Téléchargements"). Nothing else is kept in Documents. -->
	<!-- Export compliance: ITSAppUsesNonExemptEncryption is false, by decision of the project lead (18 November 2026, "Exemptée, chiffrement d'iOS"; docs/synchronisation.md,
	     section 15). Every bit of encryption in the application is the one of the system: HTTPS of WebKit, TLS 1.3 of Network.framework, HMAC-SHA-256 and SHA-256 of
	     CryptoKit, ECDSA P-256 of Security. The project implements no cipher. src/shared/ios-store-listing.test.ts refuses a cipher of its own in the sources and
	     requires this key to stay false. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Receiving links from other applications (docs/ios.md §9.4): http and https are declared so that the application can be offered as a default
	     browser. This is NOT the com.apple.developer.web-browser entitlement, which Apple grants by a form: without it the system never routes a link here
	     by itself. Only http(s) addresses are opened (`ExternalLink`); no custom scheme is declared. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.lucium.browser.ios.web</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>
