{
  "name": "lucium",
  "productName": "Lucium",
  "version": "1.1.9",
  "packageManager": "pnpm@12.16.1",
  "description": "Navigateur à sidebar verticale et espaces, bâti sur Chromium (Electron)",
  "private": true,
  "engines": {
    "node": ">=26",
    "pnpm": ">=12.16.1 <13"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/dev-electron.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:bench-script": "vitest run --config vitest.bench-script.config.mts",
    "test:snapshot-bench": "vitest run --config vitest.snapshot-bench.config.mts",
    "test:state-bench": "vitest run --config vitest.state-bench.config.mts",
    "test:sync-interop-peer": "vitest run --config vitest.sync-interop.config.mts",
    "test:engine:webstore": "electron-vite build && { profile=\"$(mktemp -d)\"; LUCIUM_SMOKE_ONLY=webstore electron . --smoke --user-data-dir=\"$profile\"; code=$?; rm -rf \"$profile\"; exit $code; }",
    "test:engine:extwindows": "electron-vite build && { profile=\"$(mktemp -d)\"; LUCIUM_SMOKE_ONLY=extwindows electron . --smoke --user-data-dir=\"$profile\"; code=$?; rm -rf \"$profile\"; exit $code; }",
    "test:engine:release": "node scripts/engine-release-run.mjs",
    "test:engine:all": "pnpm test:engine; chain=$?; pnpm test:engine:webstore; store=$?; pnpm test:engine:extwindows; windows=$?; exit $((chain || store || windows))",
    "test:engine": "LUCIUM_KEEP_NAMES=1 electron-vite build && { profile=\"$(mktemp -d)\"; LUCIUM_EXTENSIONS=\"${LUCIUM_EXTENSIONS:-$PWD/compat/api-probe:$PWD/compat/sidepanel-probe:$PWD/compat/surface-probe:$PWD/compat/shim-guard-probe:$PWD/compat/no-permission-probe:$PWD/compat/sec-driver-probe:$PWD/compat/active-tab-probe:$PWD/compat/data-api-probe:$PWD/compat/data-api-denied-probe:$PWD/compat/keyext-probe}\" LUCIUM_SMOKE_REPORT=\"${LUCIUM_SMOKE_REPORT:-$PWD/out-engine/report.json}\" electron . --smoke --user-data-dir=\"$profile\"; code=$?; rm -rf \"$profile\"; exit $code; }",
    "test:e2e": "electron-vite build && playwright test",
    "package:signed": "electron-vite build && pnpm build:native && electron-builder --mac --dir --arm64 -c.mac.identity=\"$LUCIUM_SIGN_IDENTITY\" -c.mac.hardenedRuntime=true -c.mac.entitlements=build/entitlements.mac.plist -c.mac.entitlementsInherit=build/entitlements.mac.plist -c.electronFuses.resetAdHocDarwinSignature=false",
    "package": "electron-vite build && pnpm build:native && electron-builder --mac --dir --arm64",
    "build:keychain": "bash native/vault-keychain/build.sh",
    "build:translate": "bash native/system-translate/build.sh",
    "build:vault-xpc": "bash native/vault-xpc/build.sh",
    "build:native": "pnpm build:keychain && pnpm build:vault-xpc && pnpm build:translate",
    "build:drm": "bash scripts/build-drm-release.sh",
    "verify:app": "node scripts/verify-app.mjs",
    "fuses:read": "node scripts/fuses-read.mjs",
    "perf": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/perf.mjs",
    "bench:browsers": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/compare-browsers.mjs",
    "captures:site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/site-captures.mjs",
    "film:site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/site-film/film.mjs",
    "icons:menu": "node scripts/make-menu-icons.mjs",
    "icons:probe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-probe-icon.mjs",
    "icons:logo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/logo/make-icons.mjs",
    "census:textes": "node scripts/census-textes-reglages.mjs",
    "notices": "node scripts/make-third-party-notices.mjs",
    "probe:passkeys": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/passkey-probe.mjs",
    "compat:compare": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/compat-compare.mjs",
    "compat:baseline": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/compat-compare.mjs --write",
    "electron:watch": "node scripts/electron-watch.mjs",
    "electron:upgrade": "node scripts/electron-upgrade.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.3",
    "@mozilla/readability": "0.6.0",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "koffi": "3.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tldts": "7.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "21.0.4",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "license": "GPL-3.0-or-later"
}
